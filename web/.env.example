# Copy to .env.local and replace the placeholders. Never commit .env.local.
# Paste the full PostgreSQL connection URI supplied by your database provider.
DATABASE_URL=postgresql://USERNAME:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE

# true for hosted databases that require TLS; false only for a local dev database.
DATABASE_SSL=true
DATABASE_POOL_MAX=8

# Authentication is disabled until database migrations, email delivery, and
# account/privacy configuration are ready. Signup itself is open when enabled.
AUTH_ENABLED=false
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Required to send links after enabling auth; use a verified sender/domain.
RESEND_API_KEY=re_replace_with_provider_key
AUTH_EMAIL_FROM=Carpool Pakistan <login@example.com>
